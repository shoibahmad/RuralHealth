# RuralHealthAI environment template.
#
# Copy this file to the two places that read it:
#   cp .env.example backend/.env
#   cp .env.example frontend/.env
#
# docker compose reads the values in this file directly from the repository
# root, so `cp .env.example .env` is enough to bring the stack up.

# ---------------------------------------------------------------------------
# Backend (Django)
# ---------------------------------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-generated-secret-key

# Set to False in production.
DEBUG=True

# Comma-separated list of hostnames Django will serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL. Defaults to a local SQLite file when unset.
# Postgres example: postgres://user:password@localhost:5432/ruralhealth
DATABASE_URL=

# Logger level for the `api` namespace. Defaults to DEBUG when DEBUG is on.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# AI (optional)
# ---------------------------------------------------------------------------

# Google AI Studio key. Leave blank to run with AI features disabled - every
# AI endpoint then reports itself unavailable instead of failing.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
# These are public Firebase client identifiers, not secrets. Vite inlines them
# at build time, so they must be present before `npm run build`.

VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional: error tracking DSN (e.g. Sentry). Leave blank to disable.
# When set, error and warn log records are forwarded to the provider.
VITE_ERROR_TRACKING_DSN=

