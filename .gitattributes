# Normalise line endings so a Windows checkout still produces a working image.
# Shell scripts copied into the Docker build context must be LF, or the
# container fails at startup with: env: 'bash\r': No such file or directory
* text=auto eol=lf

*.sh    text eol=lf
Dockerfile text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows-only scripts keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Never touch binary content.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.pdf   binary
*.db    binary
*.sqlite3 binary
